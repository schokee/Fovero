<Window x:Class="Fovero.UI.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fovero.UI"
        mc:Ignorable="d"
        Title="Overview" 
        Height="450" MaxWidth="1024"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance {x:Type local:ReviewViewModel}, IsDesignTimeCreatable=False}">
    <ItemsControl ItemsSource="{Binding Images}" Margin="10" IsTabStop="False" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid IsItemsHost="True" Columns="5" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type BitmapSource}">
                <Border Padding="3" BorderThickness="1" BorderBrush="{StaticResource MahApps.Brushes.Button.Border}" Margin="2">
                    <Image Source="{Binding }" Stretch="Uniform" Height="180" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
